+# When USE_SYSTEM_LIBS is on, find system packages for the dependencies
+# that can be provided by Fedora -devel packages.
+if(USE_SYSTEM_LIBS)
+    message(STATUS "USE_SYSTEM_LIBS: ON — will use system -devel packages where available")
+    # Add system cmake module paths for find_package (OpenVDB has Find*.cmake only)
+    list(APPEND CMAKE_MODULE_PATH "/usr/lib64/cmake/OpenVDB")
+    find_package(ZLIB)
+    find_package(PNG)
+    find_package(EXPAT)
+    find_package(CURL)
+    find_package(JPEG)
+    find_package(Freetype)
+    find_package(TBB)
+    find_package(NLopt)
+    find_package(cereal)
+    find_package(GLEW)
+    find_package(OpenCASCADE)
+    find_package(OpenCV 4.0)
+    # System OpenVDB has compatibility issues with bundled FindOpenVDB.cmake
+    # Keep building bundled OpenVDB with system TBB/Blosc
+    find_package(PkgConfig)
+    if(PKG_CONFIG_FOUND)
+        pkg_check_modules(BLOSC blosc)
+        pkg_check_modules(GMP gmp)
+    endif()
+endif()
+
