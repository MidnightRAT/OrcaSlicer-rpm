diff --git a/deps/CGAL/CGAL.cmake b/deps/CGAL/CGAL.cmake
index a3886383..b886d42f 100644
--- a/deps/CGAL/CGAL.cmake
+++ b/deps/CGAL/CGAL.cmake
@@ -9,7 +9,12 @@ orcaslicer_add_cmake_project(
     # For whatever reason, this keeps downloading forever (repeats downloads if finished)
     URL      https://github.com/CGAL/cgal/releases/download/v6.2.1/CGAL-6.2.1.zip
     URL_HASH SHA256=eebd737d9b7f0199647ba5c1f9f6c7a3d0651aacef9c2fd4dedc52da6c25edbe
-    DEPENDS dep_Boost dep_Eigen dep_GMP dep_MPFR
+    # Only depend on the bundled targets that actually exist: when the
+    # system provides Boost/Eigen/GMP/MPFR (see the RPM system probe in
+    # deps/CMakeLists.txt) the corresponding dep_* targets are skipped and
+    # naming them here would make the superbuild fail with "no rule to make
+    # target".
+    DEPENDS ${BOOST_PKG} ${EIGEN_PKG} ${GMP_PKG} ${MPFR_PKG}
 )
 
 include(GNUInstallDirs)
diff --git a/deps/Eigen/Eigen.cmake b/deps/Eigen/Eigen.cmake
index 2a9cc710..b666fff0 100644
--- a/deps/Eigen/Eigen.cmake
+++ b/deps/Eigen/Eigen.cmake
@@ -22,5 +22,7 @@ orcaslicer_add_cmake_project(Eigen
         -DEIGEN_BUILD_TESTING=OFF
         -DEIGEN_BUILD_BLAS=OFF
         -DEIGEN_BUILD_LAPACK=OFF
-    DEPENDS dep_Boost dep_GMP dep_MPFR
+    # System Boost/GMP/MPFR skip their dep_* targets (RPM system probe), so
+    # only the bundled ones may be named as dependencies.
+    DEPENDS ${BOOST_PKG} ${GMP_PKG} ${MPFR_PKG}
 )
diff --git a/deps/MPFR/MPFR.cmake b/deps/MPFR/MPFR.cmake
