@@ -979,12 +983,25 @@ set(_bundled_python_version "3.12.13")
 set(_bundled_python_abi "312")
 string(REGEX REPLACE "^([0-9]+\\.[0-9]+)\\..*$" "\\1" _bundled_python_version_short "${_bundled_python_version}")
 set(_bundled_python_root "${CMAKE_PREFIX_PATH}/libpython")
-set(Python3_ROOT_DIR "${_bundled_python_root}" CACHE PATH "Root directory for bundled Python" FORCE)
+# The RPM build consumes the distribution's python3.12 instead of the bundled
+# CPython, in which case the deps superbuild leaves ${CMAKE_PREFIX_PATH}/libpython
+# out of the tree. Only pin Python3_ROOT_DIR when the bundled runtime really is
+# there: a dangling hint would hide the system interpreter from FindPython3.
+set(_orca_have_bundled_python FALSE)
+if (EXISTS "${_bundled_python_root}")
+    set(_orca_have_bundled_python TRUE)
+endif ()
+if (_orca_have_bundled_python)
+    set(Python3_ROOT_DIR "${_bundled_python_root}" CACHE PATH "Root directory for bundled Python" FORCE)
+endif ()
 set(Python3_USE_STATIC_LIBS OFF)
 set(Python3_FIND_STRATEGY LOCATION)
 set(Python3_FIND_IMPLEMENTATIONS CPython)
 
-if(WIN32)
+if (NOT _orca_have_bundled_python)
+    # System interpreter (RPM build): nothing to pin here, FindPython3 resolves
+    # the distribution's python3.12 on its own.
+elseif(WIN32)
     set(_bundled_python_executable "${_bundled_python_root}/python.exe")
     set(_bundled_python_library "${_bundled_python_root}/libs/python${_bundled_python_abi}.lib")
     if(EXISTS "${_bundled_python_root}/python_d.exe")
@@ -1034,9 +1051,20 @@ elseif(APPLE)
     set(Python3_LIBRARY "${_bundled_python_library}" CACHE FILEPATH "Bundled Python embed library" FORCE)
 endif()
 
-find_package(Python3 ${_bundled_python_version} EXACT REQUIRED
-    COMPONENTS Interpreter Development.Embed
-)
+if (_orca_have_bundled_python)
+    find_package(Python3 ${_bundled_python_version} EXACT REQUIRED
+        COMPONENTS Interpreter Development.Embed
+    )
+else ()
+    # The bundled CPython build is skipped - take the distribution's 3.12
+    # (Fedora python3.12 / python3.12-devel).  A version range is mandatory:
+    # a bare "3.12" means ">= 3.12" and would select Fedora's newer default
+    # python3, while PythonInterpreter.cpp hardcodes the python3.12 stdlib
+    # layout.  CMake < 3.19 has no version ranges (Fedora ships >= 3.19).
+    find_package(Python3 3.12...3.13 REQUIRED
+        COMPONENTS Interpreter Development.Embed
+    )
+endif ()
 
