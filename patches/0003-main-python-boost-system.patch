-set(Boost_NO_SYSTEM_PATHS TRUE)
+# RPM/system build: let the distribution's Boost (boost-devel + boost-static)
+# satisfy this. The bundled Boost is only built when the probe in
+# deps/CMakeLists.txt finds no usable system Boost, so either way exactly one
+# of the two is picked up through CMAKE_PREFIX_PATH.
+set(Boost_NO_SYSTEM_PATHS FALSE)
