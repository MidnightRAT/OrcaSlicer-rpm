@@ -683,3 +683,8 @@
 # Find the OCCT and related libraries
-set(OpenCASCADE_DIR "${CMAKE_PREFIX_PATH}/lib/cmake/occt")
+# The bundled OCCT installs its config under the deps prefix; when the build
+# consumes the system opencascade-devel instead, that prefix has no occt config
+# and OpenCASCADE_DIR must not point at a non-existent directory.
+if (EXISTS "${CMAKE_PREFIX_PATH}/lib/cmake/occt/OpenCASCADEConfig.cmake")
+    set(OpenCASCADE_DIR "${CMAKE_PREFIX_PATH}/lib/cmake/occt")
+endif ()
 find_package(OpenCASCADE REQUIRED)
