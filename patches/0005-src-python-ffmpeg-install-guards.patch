diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index c8d882f2..762a7e13 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -163,8 +163,11 @@ elseif (UNIX AND NOT WIN32)
     set_target_properties(OrcaSlicer PROPERTIES
         # Build tree + AppImage, which packages the build-tree binary.
         BUILD_RPATH "$ORIGIN/python/lib;$ORIGIN/../lib/python/lib"
-        # Flatpak (cmake --install).
-        INSTALL_RPATH "$ORIGIN/../libpython/lib")
+        # Flatpak (cmake --install) stages the bundled libpython under
+        # ../libpython; $ORIGIN covers the FFmpeg .so files the bundled deps
+        # build installs next to the binary. Dead entries are skipped by the
+        # loader, so the system-FFmpeg build simply ignores them.
+        INSTALL_RPATH "$ORIGIN;$ORIGIN/../libpython/lib")
 endif ()
 
 if (NOT WIN32 AND NOT APPLE)
@@ -360,11 +363,15 @@ else ()
         COMMAND ln -sfn "${SLIC3R_RESOURCES_DIR}" "${BIN_RESOURCES_DIR}"
         COMMENT "Symlinking the resources directory into the build tree"
         VERBATIM)
-    add_custom_command(TARGET OrcaSlicer POST_BUILD
-        COMMAND ${CMAKE_COMMAND} -E rm -rf "${BIN_DIR}/python"
-        COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_PREFIX_PATH}/libpython" "${BIN_DIR}/python"
-        COMMENT "Copying Python runtime into the build tree"
-        VERBATIM)
+    # The bundled CPython runtime is only staged when the deps build produced
+    # one; the RPM build uses the system python3.12 and has no libpython here.
+    if (EXISTS "${CMAKE_PREFIX_PATH}/libpython")
+        add_custom_command(TARGET OrcaSlicer POST_BUILD
+            COMMAND ${CMAKE_COMMAND} -E rm -rf "${BIN_DIR}/python"
+            COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_PREFIX_PATH}/libpython" "${BIN_DIR}/python"
+            COMMENT "Copying Python runtime into the build tree"
+            VERBATIM)
+    endif()
     # Stage uv next to the binary for the build-tree/.app flows, which never
     # run install() -- see the layout map above; lookup is bundled_uv_path().
     if(ORCA_BUNDLED_UV_EXECUTABLE AND EXISTS "${ORCA_BUNDLED_UV_EXECUTABLE}")
@@ -400,7 +407,9 @@ if (WIN32)
 else ()
     if (APPLE)
     else()
-        install(FILES ${output_sos_${build_type}} DESTINATION "${CMAKE_INSTALL_PREFIX}")
+        if (output_sos_${build_type})
+            install(FILES ${output_sos_${build_type}} DESTINATION "${CMAKE_INSTALL_PREFIX}")
+        endif()
     endif()
     install(TARGETS OrcaSlicer RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}" BUNDLE DESTINATION ${CMAKE_INSTALL_BINDIR})
 endif ()
