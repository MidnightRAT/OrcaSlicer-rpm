 endif()
 
+# RPM/system-devel support: on non-Flatpak Linux builds consume as many
+# libraries as possible from the distribution's -devel packages.  Every library
+# found below is skipped in the bundled deps build and resolved by the
+# OrcaSlicer top-level build through CMake's normal search paths.  When a
+# package is missing, the corresponding `if (NOT <NAME>_FOUND) include(...)`
+# guard falls back to the bundled build (fail-safe, no hard error).
+# Only libraries with no compatible RPM in the distribution stay bundled:
+# wxWidgets 3.3, TBB (static), the custom OpenVDB fork, OpenEXR 2.x for that
+# fork, libnoise, SolveSpace and wxInspector.
+if(NOT FLATPAK AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    find_package(PNG QUIET)
+    find_package(JPEG QUIET)
+    find_package(OpenSSL QUIET)
+    find_package(CURL QUIET)
+    find_package(Eigen3 QUIET)
+    find_package(CGAL QUIET)
+    # OrcaSlicer 2.5 requires CGAL >= 6.2 (find_package(CGAL 6.2 REQUIRED)).
+    # An older system CGAL must fall back to the bundled build instead of
+    # failing the main configure step.
+    if (CGAL_FOUND AND CGAL_VERSION VERSION_LESS "6.2")
+        message(STATUS "System CGAL ${CGAL_VERSION} is older than 6.2 - using bundled CGAL")
+        unset(CGAL_FOUND)
+        unset(CGAL_DIR)
+    endif ()
+    find_package(cereal QUIET)
+    find_package(NLopt QUIET)
+    find_package(draco QUIET)
+    find_package(Qhull QUIET)
+    find_package(glfw3 QUIET)
+    find_package(OpenCV QUIET)
+    find_package(assimp QUIET)
+    find_package(OpenCASCADE QUIET)
+    find_package(LibDataChannel CONFIG QUIET)
+    # No FindBlosc module and no blosc-config.cmake in the distribution -
+    # probe the header/library directly (same fallback FindOpenVDB uses).
+    find_path(Blosc_INCLUDE_DIR blosc.h)
+    find_library(Blosc_LIBRARY NAMES blosc)
+    if (Blosc_INCLUDE_DIR AND Blosc_LIBRARY)
+        set(Blosc_FOUND TRUE)
+    endif ()
+
+    # Boost: SLIC3R_STATIC=1 links Boost statically, so only a static system
+    # Boost (boost-static) may replace the bundled 1.84 build.
+    set(Boost_USE_STATIC_LIBS ON)
+    find_package(Boost 1.83 QUIET
+        COMPONENTS system filesystem thread log log_setup locale regex
+                   chrono atomic date_time iostreams program_options nowide)
+
+    # FFmpeg (libav*) through pkg-config; the bundled build is skipped when the
+    # system's ffmpeg-free-devel provides the four libraries the GUI links.
+    find_package(PkgConfig QUIET)
+    if (PkgConfig_FOUND)
+        pkg_check_modules(SYSTEM_FFMPEG QUIET libavformat libavcodec libswscale libavutil)
+    endif ()
+
+    # Python: the main build needs an embedded 3.12 interpreter.  Fedora ships
+    # python3.12/python3.12-devel, so the (slow, PGO-enabled) bundled CPython
+    # build is unnecessary.  The version range is required: a bare "3.12" means
+    # ">= 3.12" and would happily match Fedora's newer default python3.
+    find_package(Python3 3.12...3.13 QUIET COMPONENTS Interpreter Development.Embed)
+
+    # GMP / MPFR ship no find module in this project - probe headers + libs
+    find_path(GMP_INCLUDE_DIR NAMES gmp.h)
+    find_library(GMP_LIBRARY NAMES gmp)
+    if(GMP_INCLUDE_DIR AND GMP_LIBRARY)
+        set(GMP_FOUND TRUE)
+    endif()
+    find_path(MPFR_INCLUDE_DIR NAMES mpfr.h)
+    find_library(MPFR_LIBRARY NAMES mpfr)
+    if(MPFR_INCLUDE_DIR AND MPFR_LIBRARY)
+        set(MPFR_FOUND TRUE)
+    endif()
+endif()
+
