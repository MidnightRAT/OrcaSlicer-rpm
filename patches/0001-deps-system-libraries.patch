+# RPM/system-devel support: on non-Flatpak Linux builds, consume as many
+# libraries as possible from the distribution's -devel packages.  Every
+# library found below is skipped in the bundled deps build and resolved by
+# the OrcaSlicer top-level build through CMake's system search paths.  When
+# a package is missing, the corresponding `if (NOT <NAME>_FOUND) include(...)`
+# guard silently falls back to the bundled build (see the *_PKG variables).
+if(NOT FLATPAK AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    find_package(PNG QUIET)
+    find_package(JPEG QUIET)
+    find_package(Freetype QUIET)
+    find_package(OpenSSL QUIET)
+    find_package(CURL QUIET)
+    find_package(Eigen3 QUIET)
+    find_package(CGAL QUIET)
+    # CGAL >= 6.0 changed the Surface_mesh property_map API (returns
+    # std::optional instead of std::pair).  OrcaSlicer 2.4.2 was written
+    # against the bundled CGAL 5.6.3, so a too-new system CGAL must fall back
+    # to the bundled build instead of breaking CutSurface.cpp compilation.
+    if (CGAL_FOUND AND CGAL_VERSION VERSION_GREATER_EQUAL "6.0")
+        message(STATUS "System CGAL ${CGAL_VERSION} is too new (CGAL >= 6 changed the Surface_mesh property_map API) - using bundled CGAL 5.6.3")
+        unset(CGAL_FOUND)
+        unset(CGAL_DIR)
+    endif ()
+    find_package(cereal QUIET)
+    find_package(NLopt QUIET)
+    find_package(draco QUIET)
+    find_package(Qhull QUIET)
+    find_package(glfw3 QUIET)
+    find_package(OpenCV QUIET)
+
+    # GMP / MPFR ship no find module in this project - probe headers + libs
+    find_path(GMP_INCLUDE_DIR NAMES gmp.h)
+    find_library(GMP_LIBRARY NAMES gmp)
+    if(GMP_INCLUDE_DIR AND GMP_LIBRARY)
+        set(GMP_FOUND TRUE)
+    endif()
+    find_path(MPFR_INCLUDE_DIR NAMES mpfr.h)
+    find_library(MPFR_LIBRARY NAMES mpfr)
+    if(MPFR_INCLUDE_DIR AND MPFR_LIBRARY)
+        set(MPFR_FOUND TRUE)
+    endif()
+endif()
+
