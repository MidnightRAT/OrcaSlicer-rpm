diff --git a/cmake/modules/FindBlosc.cmake b/cmake/modules/FindBlosc.cmake
new file mode 100644
index 00000000..52bc2f20
--- /dev/null
+++ b/cmake/modules/FindBlosc.cmake
@@ -0,0 +1,65 @@
+# Locate the Blosc compression library.
+#
+# Fedora ships a dummy config file named c-blosc-config.cmake that only exports
+# a c-blosc::c-blosc pkg-config alias, so neither BloscConfig.cmake nor
+# blosc-config.cmake exists and find_package(Blosc) has nothing to load in
+# config mode. This module therefore does the search itself and exports the
+# Blosc::blosc target that OpenVDB and FindOpenVDB expect.
+#
+# Result variables:
+#   Blosc_FOUND
+#   Blosc_VERSION
+#   Blosc_INCLUDE_DIR
+#   Blosc_LIBRARY
+#
+# Imported target: Blosc::blosc
+
+find_package(PkgConfig QUIET)
+if (PkgConfig_FOUND)
+    pkg_check_modules(PC_BLOSC QUIET blosc)
+endif ()
+
+find_path(Blosc_INCLUDE_DIR
+    NAMES blosc.h
+    HINTS ${PC_BLOSC_INCLUDE_DIRS}
+)
+find_library(Blosc_LIBRARY
+    NAMES blosc
+    HINTS ${PC_BLOSC_LIBRARY_DIRS}
+)
+
+set(Blosc_VERSION ${PC_BLOSC_VERSION})
+if (NOT Blosc_VERSION AND Blosc_INCLUDE_DIR AND EXISTS "${Blosc_INCLUDE_DIR}/blosc.h")
+    # No usable blosc.pc - read the version straight out of the header.
+    file(STRINGS "${Blosc_INCLUDE_DIR}/blosc.h" _blosc_version_major
+        REGEX "^#define[ \t]+BLOSC_VERSION_MAJOR[ \t]+[0-9]+")
+    file(STRINGS "${Blosc_INCLUDE_DIR}/blosc.h" _blosc_version_minor
+        REGEX "^#define[ \t]+BLOSC_VERSION_MINOR[ \t]+[0-9]+")
+    file(STRINGS "${Blosc_INCLUDE_DIR}/blosc.h" _blosc_version_release
+        REGEX "^#define[ \t]+BLOSC_VERSION_RELEASE[ \t]+[0-9]+")
+    string(REGEX REPLACE ".*[ \t]([0-9]+)$" "\\1" _blosc_version_major "${_blosc_version_major}")
+    string(REGEX REPLACE ".*[ \t]([0-9]+)$" "\\1" _blosc_version_minor "${_blosc_version_minor}")
+    string(REGEX REPLACE ".*[ \t]([0-9]+)$" "\\1" _blosc_version_release "${_blosc_version_release}")
+    if (_blosc_version_major)
+        set(Blosc_VERSION "${_blosc_version_major}.${_blosc_version_minor}.${_blosc_version_release}")
+    endif ()
+    unset(_blosc_version_major)
+    unset(_blosc_version_minor)
+    unset(_blosc_version_release)
+endif ()
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(Blosc
+    REQUIRED_VARS Blosc_LIBRARY Blosc_INCLUDE_DIR
+    VERSION_VAR Blosc_VERSION
+)
+
+if (Blosc_FOUND AND NOT TARGET Blosc::blosc)
+    add_library(Blosc::blosc UNKNOWN IMPORTED)
+    set_target_properties(Blosc::blosc PROPERTIES
+        IMPORTED_LOCATION "${Blosc_LIBRARY}"
+        INTERFACE_INCLUDE_DIRECTORIES "${Blosc_INCLUDE_DIR}"
+    )
+endif ()
+
+mark_as_advanced(Blosc_INCLUDE_DIR Blosc_LIBRARY)
